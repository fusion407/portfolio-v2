{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npx --yes npm@11.19.1 ci",
  "buildCommand": "npm run lint && npm run typecheck && NODE_ENV=test npm test && npm run build:preview",
  "redirects": [
    { "source": "/about", "destination": "/#about", "statusCode": 301 },
    { "source": "/skills", "destination": "/#stack", "statusCode": 301 },
    {
      "source": "/experience",
      "destination": "/#experience",
      "statusCode": 301
    }
  ]
}
